{
  "name": "portcontext",
  "version": "0.1.0",
  "description": "Portable, user-owned AI context that carries across tools (Copilot, Cursor, Claude, ...).",
  "type": "module",
  "bin": {
    "portcontext": "dist/cli.js"
  },
  "main": "dist/index.js",
